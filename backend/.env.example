# Copy to backend/.env for local development. Never commit the real .env file.
DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave empty to use a local SQLite file while DEBUG=True.
# Local PostgreSQL example: postgres://bbs:bbs@localhost:5432/bbs
DATABASE_URL=
DATABASE_SSL_REQUIRE=False
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=
# Admin lives at /<this path>/ (default: manage-enquiries)
DJANGO_ADMIN_PATH=manage-enquiries
# Set to 1 when running behind one reverse proxy (Render); leave empty locally.
DRF_NUM_PROXIES=
ENQUIRY_RATE_BURST=3/min
ENQUIRY_RATE_SUSTAINED=10/day
ENQUIRY_RETENTION_DAYS=365
