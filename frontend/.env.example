# Public settings only. Everything starting with VITE_ is visible to every
# website visitor. NEVER put database URLs, passwords or secret keys here.
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# Public address of the website, used for canonical links and the sitemap.
# "npm run build" stops unless both addresses are real https:// ones.
# The local values below work with "npm run dev" and "npm run build:local".
VITE_SITE_URL=http://localhost:5173
